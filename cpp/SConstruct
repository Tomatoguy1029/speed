# 固定SDKを外部の作業領域へ置き、生成物もソースとは別の出力先へ作る。
import hashlib
import json
import subprocess
import tempfile
from pathlib import Path
import SCons
import sys

sys.path.insert(0, str(Path(Dir('.').abspath).parent / 'tools/build'))
from runtime_id import runtime_id

here = Path(Dir('.').abspath)
locked = json.loads((here / 'dependencies.json').read_text())
sdk = Path(ARGUMENTS.pop('godot_cpp_dir', str(here / 'godot-cpp'))).resolve()
if not (sdk / 'SConstruct').is_file():
    Exit('godot_cpp_dir に dependencies.json の固定SDKを指定してください')
revision = subprocess.check_output(['git', '-C', str(sdk), 'rev-parse', 'HEAD'], text=True).strip()
if revision != locked['godot_cpp']['commit']:
    Exit('godot-cpp の版が dependencies.json と一致しません')
if subprocess.call(['git', '-C', str(sdk), 'diff', '--quiet', 'HEAD', '--']) != 0:
    Exit('godot-cpp の追跡ファイルに変更があります')
if SCons.__version__ != locked['scons']:
    Exit('SCons の版が dependencies.json と一致しません')
if ARGUMENTS.get('precision', locked['precision']) != locked['precision']:
    Exit('このゲームは単精度のGodot用です')
ARGUMENTS['precision'] = locked['precision']
ARGUMENTS['build_profile'] = str(here / 'dependencies.json')
api = locked['godot_cpp']['api']
api_file = sdk / 'gdextension' / ('extension_api-' + api.replace('.', '-') + '.json')
if hashlib.sha256(api_file.read_bytes()).hexdigest() != locked['godot_cpp']['api_sha256']:
    Exit('Godot APIの定義が固定したハッシュと一致しません')
if any(key in ARGUMENTS for key in ['custom_api_file', 'gdextension_dir']):
    Exit('固定したAPI以外の入力は指定できません')
if ARGUMENTS.get('api_version', api) != api:
    Exit('対象APIがdependencies.jsonと一致しません')
ARGUMENTS['api_version'] = api
out = Path(ARGUMENTS.pop('output_dir', str(here / '../speed/extensions/run/bin'))).resolve()
build = Path(ARGUMENTS.pop('build_dir', str(Path(tempfile.gettempdir()) / 'speed-run-build' / hashlib.sha256(str(here).encode()).hexdigest()[:12]))).resolve()
SConsignFile(str(build / '.sconsign.dblite'))
shared_cache = ARGUMENTS.pop('cache_dir', '')
if shared_cache:
    CacheDir(shared_cache)
env = SConscript(str(sdk / 'SConstruct'))
if env['platform'] not in ['macos', 'windows']:
    Exit('対応するビルド対象は macos と windows です')
# 演算の結合を変えず、GDScript側の比較結果へ照合する。
if env.get('is_msvc', False):
    env.Append(CXXFLAGS=['/fp:strict'])
else:
    env.Append(CXXFLAGS=['-ffp-contract=off'])
name = 'speed_runtime' + env['suffix'] + ('.dylib' if env['platform'] == 'macos' else '.dll')
sources = Glob('api/*.cpp') + Glob('state/*.cpp') + Glob('systems/*.cpp') + Glob('systems/attacks/*.cpp') + Glob('content/*.cpp') + Glob('runtime/*.cpp') + Glob('output/*.cpp') + Glob('behaviors/heroes/*.cpp') + Glob('behaviors/weapons/*.cpp') + Glob('behaviors/traits/*.cpp') + Glob('behaviors/enemies/*.cpp') + Glob('bosses/flow/*.cpp') + Glob('bosses/monoceros/*.cpp') + Glob('bosses/centaurus/*.cpp') + Glob('bosses/canis_major/*.cpp') + Glob('bosses/hydra/*.cpp') + Glob('bosses/draco/*.cpp')
objects = []
# ロード済みC++の実装を、録画時と配布時にソース全体を走査せず識別する。
implementation = runtime_id(here)
# 識別子を小さい生成ファイルへ閉じ込め、C++を変えても既存のobjectを再コンパイルしない。
identity_source = build / 'generated' / 'build_identity.cpp'
identity_source.parent.mkdir(parents=True, exist_ok=True)
identity_text = 'namespace speed {const char *implementation_sha256() {return "' + implementation + '";}}\n'
if not identity_source.is_file() or identity_source.read_text() != identity_text:
    identity_source.write_text(identity_text)
for source in sources:
    relative = Path(source.abspath).relative_to(here.parent)
    target = build / env['platform'] / env['arch'] / relative.with_suffix('')
    objects.extend(env.SharedObject(str(target), source))
objects.extend(env.SharedObject(str(build / env['platform'] / env['arch'] / 'generated' / 'build_identity'), str(identity_source)))
library = env.SharedLibrary(str(out / name), objects)
Default(library)
