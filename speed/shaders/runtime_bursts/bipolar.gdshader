// Generated by tools/art/bake_burst_profiles.py; keep the editable base shader.
// 試作の pfire：ドット単位の炎の爆発。焼いた値ノイズで縁を崩し、密度で4段の色に分け、一番外は市松で透かす。
// 長さはドット単位。四角の中心が炎の中心で、半径の 1.2 倍の外は描かない。
// tuning の値は戦闘エフェクトツールで装備ごとに上書きする（ShaderTuning）。
shader_type canvas_item;
render_mode unshaded;
uniform bool linear_colors = true;

uniform sampler2D value_noise : repeat_disable, filter_nearest;
uniform float half_cells = 30.0;
uniform float radius = 20.0;
uniform float life = 0.0;
// 炎の中心のドット座標と種（ノイズを場所ごと・炎ごとに変える）
uniform vec2 origin = vec2(0.0);
uniform float seed = 0.0;
// 表示用の全体色と明るさ。CanvasItemのmodulateとは独立して適用する。
const vec4 _baked_effect_color = vec4(1.0, 1.0, 1.0, 1.0);
const vec4 _baked_effect_color_srgb = vec4(1.0, 1.0, 1.0, 1.0);
const float _baked_effect_energy = 1.0;
const vec4 _baked_c0 = vec4(1.0, 1.0, 1.0, 1.0);
const vec4 _baked_c0_srgb = vec4(1.0, 1.0, 1.0, 1.0);
const vec4 _baked_c1 = vec4(0.6239603757858276, 1.0, 0.9473065733909607, 1.0);
const vec4 _baked_c1_srgb = vec4(0.8117647171020508, 1.0, 0.9764705896377563, 1.0);
const vec4 _baked_c2 = vec4(0.14126327633857727, 1.0, 0.8713672161102295, 1.0);
const vec4 _baked_c2_srgb = vec4(0.4117647111415863, 1.0, 0.9411764740943909, 1.0);
const vec4 _baked_c3 = vec4(0.013702080585062504, 0.21223072707653046, 0.23839758336544037, 1.0);
const vec4 _baked_c3_srgb = vec4(0.12156862765550613, 0.49803921580314636, 0.5254902243614197, 1.0);
const float _baked_noise_scale = 0.1599999964237213;
const float _baked_roughness = 0.949999988079071;
const float _baked_burn_speed = 1.149999976158142;
const float _baked_start_size = 0.3499999940395355;
const float _baked_flash_boost = 0.699999988079071;
const float _baked_outer_dither = 1.0;

float lattice(vec3 p) {
	vec3 i = mod(p, 64.0);
	vec2 tile = vec2(mod(i.z, 8.0), floor(i.z / 8.0));
	return texture(value_noise, (tile * 64.0 + i.xy + 0.5) / 512.0).r;
}

float vnoise(vec3 p) {
	vec3 i = floor(p);
	vec3 f = fract(p);
	vec3 u = f * f * (3.0 - 2.0 * f);
	float a = mix(mix(lattice(i), lattice(i + vec3(1, 0, 0)), u.x), mix(lattice(i + vec3(0, 1, 0)), lattice(i + vec3(1, 1, 0)), u.x), u.y);
	float b = mix(mix(lattice(i + vec3(0, 0, 1)), lattice(i + vec3(1, 0, 1)), u.x), mix(lattice(i + vec3(0, 1, 1)), lattice(i + vec3(1, 1, 1)), u.x), u.y);
	return mix(a, b, u.z);
}

void fragment() {
	vec2 cell = floor((UV - 0.5) * 2.0 * half_cells);
	float rt = radius * (_baked_start_size + (1.0 - _baked_start_size) * (1.0 - pow(1.0 - min(1.0, life * 3.0), 3.0)));
	float d = length(cell) / max(rt, 0.1);
	if (d > 1.2) {
		discard;
	}
	vec2 at = cell + origin;
	float n = vnoise(vec3(at.x * _baked_noise_scale + seed, at.y * _baked_noise_scale - life * 3.0, life * 5.0 + seed));
	float den = (1.0 - d) * 1.35 + (n - 0.5) * _baked_roughness - life * _baked_burn_speed + (life < 0.07 ? _baked_flash_boost : 0.0);
	if (den > 0.8) {
		COLOR = (linear_colors ? _baked_c0 : _baked_c0_srgb);
	} else if (den > 0.55) {
		COLOR = (linear_colors ? _baked_c1 : _baked_c1_srgb);
	} else if (den > 0.33) {
		COLOR = (linear_colors ? _baked_c2 : _baked_c2_srgb);
	} else if (den > 0.16) {
		float coverage = mix(0.5, 1.0 - mod(at.x + at.y, 2.0), _baked_outer_dither);
		if (coverage <= 0.0) discard;
		COLOR = vec4((linear_colors ? _baked_c3 : _baked_c3_srgb).rgb, (linear_colors ? _baked_c3 : _baked_c3_srgb).a * coverage);
	} else {
		discard;
	}
	COLOR *= (linear_colors ? _baked_effect_color : _baked_effect_color_srgb);
	COLOR.rgb *= _baked_effect_energy;
}
