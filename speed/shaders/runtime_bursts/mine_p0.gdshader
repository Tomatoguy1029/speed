const float _baked_spark_seconds = 0.30000001192092896;

vec4 over(vec4 dst, vec3 c, float a) {
	float out_a = a + dst.a * (1.0 - a);
	if (out_a <= 0.0) return vec4(0.0);
	return vec4((c * a + dst.rgb * dst.a * (1.0 - a)) / out_a, out_a);
}

float out_quart(float t) { return 1.0 - pow(1.0 - clamp(t, 0.0, 1.0), 4.0); }
float out_cubic(float t) { return 1.0 - pow(1.0 - clamp(t, 0.0, 1.0), 3.0); }

float drift(float v0, float t) { return v0 * (1.0 - exp(-0.6 * t)) / 0.6; }

void vertex() {
	float R = max(radius, 1.0);
	max_reach = half_cells;
	if (age < _baked_spark_seconds + 0.06) max_reach = max(max_reach, R * 0.16 + drift(R * 6.6 * _baked_spark_speed, age) + 17.0);
	if (age < _baked_ring_seconds) max_reach = max(max_reach, R * (0.21 + _baked_ring_size) + 3.0);

		float core_reach = 0.0;
		if (age < _baked_fire_seconds) core_reach = R * (_baked_start_size + (1.0 - _baked_start_size) * out_quart(age / _baked_grow_seconds)) * 1.2 + 1.0;
		if (age < _baked_flash_seconds) core_reach = max(core_reach, R * 0.16 + R * _baked_flash_size * age / _baked_flash_seconds);
		if (age < _baked_ring_seconds) {
