// Generated by tools/art/bake_burst_profiles.py; keep the editable base shader.
shader_type canvas_item;
render_mode unshaded;
uniform bool linear_colors = true;

uniform float half_cells = 120.0;
uniform float radius = 38.0;
uniform float age = 0.0;

uniform float seed = 0.0;

varying vec2 burst_position;
varying flat vec4 particle_state;
varying flat float max_reach;
const vec4 _baked_effect_color = vec4(1.0, 1.0, 1.0, 1.0);
const vec4 _baked_effect_color_srgb = vec4(1.0, 1.0, 1.0, 1.0);
const float _baked_effect_energy = 0.8999999761581421;

const vec4 _baked_smoke_dark = vec4(0.04214945062994957, 0.02322782203555107, 0.0253068208694458, 1.0);
const vec4 _baked_smoke_dark_srgb = vec4(0.22699999809265137, 0.16500000655651093, 0.17299999296665192, 1.0);
const vec4 _baked_smoke_mid = vec4(0.1121688112616539, 0.06146494299173355, 0.05794929340481758, 1.0);
const vec4 _baked_smoke_mid_srgb = vec4(0.36899998784065247, 0.2750000059604645, 0.2669999897480011, 1.0);
const vec4 _baked_smoke_light = vec4(0.25397154688835144, 0.14435912668704987, 0.1121688112616539, 1.0);
const vec4 _baked_smoke_light_srgb = vec4(0.5410000085830688, 0.41600000858306885, 0.36899998784065247, 1.0);

const float _baked_ring_seconds = 0.30000001192092896;
const float _baked_ring_size = 1.0;

const float _baked_spark_speed = 1.0;
const float _baked_spark_seconds = 0.30000001192092896;

const float _baked_smoke_count = 13.0;
const float _baked_smoke_alpha = 0.699999988079071;
const float _baked_smoke_seconds = 0.9000000357627869;

float rnd(float i, float k) {
	return fract(sin(dot(vec3(i, k, seed), vec3(12.9898, 78.233, 37.719))) * 43758.5453);
}

vec4 over(vec4 dst, vec3 c, float a) {
	float out_a = a + dst.a * (1.0 - a);
	if (out_a <= 0.0) return vec4(0.0);
	return vec4((c * a + dst.rgb * dst.a * (1.0 - a)) / out_a, out_a);
}

float out_cubic(float t) { return 1.0 - pow(1.0 - clamp(t, 0.0, 1.0), 3.0); }

float drift(float v0, float t) { return v0 * (1.0 - exp(-0.6 * t)) / 0.6; }

vec4 smoke_state(float i) {
	if (i >= _baked_smoke_count || age <= 0.12) return vec4(0.0);
	float R = max(radius, 1.0);
	float t0 = mix(0.12, 0.3, rnd(i, 21.0));
	float span = mix(0.75, 1.0, rnd(i, 22.0)) * _baked_smoke_seconds;
	float u = (age - t0) / span;
	if (u <= 0.0 || u >= 1.0) return vec4(0.0);
	float a = rnd(i, 23.0) * TAU;
	vec2 dir = vec2(cos(a), sin(a));
	vec2 v = vec2(dir.x * mix(4.0, 12.0, rnd(i, 24.0)), dir.y * mix(4.0, 12.0, rnd(i, 25.0)) - mix(1.0, 4.0, rnd(i, 26.0))) / 38.0 * R;
	vec2 c = dir * mix(0.25, 0.8, rnd(i, 27.0)) * R + v * u * span;
	float r = mix(10.0, 15.0, rnd(i, 28.0)) / 38.0 * R * (0.7 + 0.6 * out_cubic(u));
	float k = _baked_smoke_alpha * pow(1.0 - u, 1.3) * smoothstep(0.0, 0.2, u);
	return vec4(c, r, k);
}

void vertex() {
	float R = max(radius, 1.0);
	max_reach = half_cells;
	if (age < _baked_spark_seconds + 0.06) max_reach = max(max_reach, R * 0.16 + drift(R * 6.6 * _baked_spark_speed, age) + 17.0);
	if (age < _baked_ring_seconds) max_reach = max(max_reach, R * (0.21 + _baked_ring_size) + 3.0);
	particle_state = vec4(0.0);

		float i = floor(UV.x * 0.5);
		vec2 corner = vec2(UV.x - i * 2.0, UV.y);
		vec2 low = vec2(0.0);
		vec2 high = vec2(0.0);

			particle_state = smoke_state(i);
			if (particle_state.w > 0.0) {
				low = floor(particle_state.xy - particle_state.z - 1.0);
				high = ceil(particle_state.xy + particle_state.z + 1.0);
			}

		low = clamp(low, vec2(-half_cells), vec2(half_cells));
		high = clamp(high, vec2(-half_cells), vec2(half_cells));
		burst_position = mix(low, high, corner);
		VERTEX = burst_position / half_cells;

}

void fragment() {
	vec2 cell = floor(burst_position);
	vec2 p = cell + 0.5;
	float dist = length(p);
	if (dist > max_reach) discard;
	float R = max(radius, 1.0);
	vec4 col = vec4(0.0);

		vec2 c = particle_state.xy;
		float r = particle_state.z;
		float k = particle_state.w;
		if (length(p - c) <= r) col = over(col, (linear_colors ? _baked_smoke_dark : _baked_smoke_dark_srgb).rgb, k * (linear_colors ? _baked_smoke_dark : _baked_smoke_dark_srgb).a);
		if (length(p - c + vec2(0.2, 0.25) * r) <= r * 0.75) col = over(col, (linear_colors ? _baked_smoke_mid : _baked_smoke_mid_srgb).rgb, k * 0.55 * (linear_colors ? _baked_smoke_mid : _baked_smoke_mid_srgb).a);
		if (length(p - c + vec2(0.35, 0.4) * r) <= r * 0.4) col = over(col, (linear_colors ? _baked_smoke_light : _baked_smoke_light_srgb).rgb, k * 0.35 * (linear_colors ? _baked_smoke_light : _baked_smoke_light_srgb).a);

	if (col.a <= 0.0) discard;
	COLOR = vec4(col.rgb * _baked_effect_energy, col.a) * (linear_colors ? _baked_effect_color : _baked_effect_color_srgb);
}
