// Generated by tools/art/bake_burst_profiles.py; keep the editable base shader.
shader_type canvas_item;
render_mode unshaded;
uniform bool linear_colors = true;

uniform float half_cells = 120.0;
uniform float radius = 38.0;
uniform float age = 0.0;

uniform float seed = 0.0;

varying vec2 burst_position;
varying flat vec4 particle_state;
varying flat vec4 particle_extra;
varying flat vec4 particle_color;
varying flat float max_reach;
const vec4 _baked_effect_color = vec4(1.0, 1.0, 1.0, 1.0);
const vec4 _baked_effect_color_srgb = vec4(1.0, 1.0, 1.0, 1.0);
const float _baked_effect_energy = 0.8999999761581421;
const vec4 _baked_c0 = vec4(1.0, 1.0, 1.0, 1.0);
const vec4 _baked_c0_srgb = vec4(1.0, 1.0, 1.0, 1.0);
const vec4 _baked_c1 = vec4(1.0, 0.8878815174102783, 0.3918048143386841, 1.0);
const vec4 _baked_c1_srgb = vec4(1.0, 0.9490000009536743, 0.6589999794960022, 1.0);
const vec4 _baked_c2 = vec4(1.0, 0.4338795244693756, 0.029488254338502884, 1.0);
const vec4 _baked_c2_srgb = vec4(1.0, 0.6899999976158142, 0.18799999356269836, 1.0);

const float _baked_ring_seconds = 0.30000001192092896;
const float _baked_ring_size = 1.0;

const float _baked_spark_count = 40.0;
const float _baked_spark_speed = 1.0;
const float _baked_spark_seconds = 0.30000001192092896;

float rnd(float i, float k) {
	return fract(sin(dot(vec3(i, k, seed), vec3(12.9898, 78.233, 37.719))) * 43758.5453);
}

float drift(float v0, float t) { return v0 * (1.0 - exp(-0.6 * t)) / 0.6; }

void spark_state(float i, out vec4 state, out vec4 extra, out vec4 color) {
	state = vec4(0.0);
	extra = vec4(0.0);
	color = vec4(0.0);
	if (i >= _baked_spark_count || age >= _baked_spark_seconds + 0.06) return;
	float t = age - rnd(i, 41.0) * 0.06;
	float span = mix(0.4, 1.0, rnd(i, 42.0)) * _baked_spark_seconds;
	if (t < 0.0 || t >= span) return;
	float R = max(radius, 1.0);
	float a = rnd(i, 43.0) * TAU;
	vec2 dir = vec2(cos(a), sin(a));
	float v0 = R * mix(2.4, 6.6, rnd(i, 44.0)) * _baked_spark_speed;
	vec2 head = dir * (R * 0.16 + drift(v0, t));
	float len = min(16.0, 0.5 + v0 * exp(-0.6 * t) * 0.026) * mix(0.7, 1.4, rnd(i, 45.0));
	float k = 1.0 - t / span;
	float pick = rnd(i, 46.0);
	state = vec4(head, dir);
	extra = vec4(len, k < 0.35 ? k / 0.35 : 1.0, 0.0, 0.0);
	color = pick < 0.25 ? (linear_colors ? _baked_c0 : _baked_c0_srgb) : pick < 0.75 ? (linear_colors ? _baked_c1 : _baked_c1_srgb) : (linear_colors ? _baked_c2 : _baked_c2_srgb);
}

void vertex() {
	float R = max(radius, 1.0);
	max_reach = half_cells;
	if (age < _baked_spark_seconds + 0.06) max_reach = max(max_reach, R * 0.16 + drift(R * 6.6 * _baked_spark_speed, age) + 17.0);
	if (age < _baked_ring_seconds) max_reach = max(max_reach, R * (0.21 + _baked_ring_size) + 3.0);
	particle_state = vec4(0.0);
	particle_extra = vec4(0.0);
	particle_color = vec4(0.0);

		float i = floor(UV.x * 0.5);
		vec2 corner = vec2(UV.x - i * 2.0, UV.y);
		vec2 low = vec2(0.0);
		vec2 high = vec2(0.0);

			vec4 state;
			vec4 extra;
			vec4 color;
			spark_state(i, state, extra, color);
			particle_state = state;
			particle_extra = extra;
			particle_color = color;
			if (extra.y > 0.0) {
				vec2 tail = state.xy - state.zw * extra.x;
				low = floor(min(state.xy, tail) - 2.0);
				high = ceil(max(state.xy, tail) + 2.0);
			}

		low = clamp(low, vec2(-half_cells), vec2(half_cells));
		high = clamp(high, vec2(-half_cells), vec2(half_cells));
		burst_position = mix(low, high, corner);
		VERTEX = burst_position / half_cells;

}

void fragment() {
	vec2 cell = floor(burst_position);
	vec2 p = cell + 0.5;
	float dist = length(p);
	if (dist > max_reach) discard;
	float R = max(radius, 1.0);
	vec4 col = vec4(0.0);

		vec2 dir = particle_state.zw;
		vec2 rel = p - particle_state.xy;
		float along = dot(rel, dir);
		float len = particle_extra.x;
		if (along > 0.5 || along < -len || abs(rel.x * dir.y - rel.y * dir.x) > 0.55) discard;
		vec3 c = particle_color.rgb;
		if (along < -len * 0.4) c *= 0.55;
		col = vec4(c, particle_extra.y * particle_color.a);

	if (col.a <= 0.0) discard;
	COLOR = vec4(col.rgb * _baked_effect_energy, col.a) * (linear_colors ? _baked_effect_color : _baked_effect_color_srgb);
}
