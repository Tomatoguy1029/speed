				if (age < _baked_flash_seconds) den += 0.6;
				if (den > 0.8) col = over(col, (linear_colors ? _baked_c0 : _baked_c0_srgb).rgb, (linear_colors ? _baked_c0 : _baked_c0_srgb).a);
				else if (den > 0.55) col = over(col, (linear_colors ? _baked_c1 : _baked_c1_srgb).rgb, (linear_colors ? _baked_c1 : _baked_c1_srgb).a);
				else if (den > 0.33) col = over(col, (linear_colors ? _baked_c2 : _baked_c2_srgb).rgb, (linear_colors ? _baked_c2 : _baked_c2_srgb).a);
				else if (den > 0.16) col = over(col, (linear_colors ? _baked_c3 : _baked_c3_srgb).rgb, (linear_colors ? _baked_c3 : _baked_c3_srgb).a * _baked_outer_alpha);
			}
		}
