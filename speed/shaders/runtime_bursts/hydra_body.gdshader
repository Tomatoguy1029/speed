// Generated by tools/art/bake_burst_profiles.py; keep the editable base shader.
shader_type canvas_item;
render_mode unshaded, blend_add;
uniform bool linear_colors = true;
uniform vec4 tint : source_color = vec4(1.0,0.6,0.3,1.0);
uniform float progress = 0.0;
uniform float pixels = 48.0;
uniform float seed = 0.0;
// 表示用の全体色と明るさ。CanvasItemのmodulateとは独立して適用する。
const vec4 _baked_effect_color = vec4(1.0, 1.0, 1.0, 1.0);
const vec4 _baked_effect_color_srgb = vec4(1.0, 1.0, 1.0, 1.0);
const float _baked_effect_energy = 1.0;
const float _baked_spokes = 18.0;
const float _baked_ring_start = 0.11999999731779099;
const float _baked_ring_growth = 0.6299999952316284;
const float _baked_ring_noise = 0.11999999731779099;
const float _baked_ring_thickness = 0.02500000037252903;
const float _baked_ring_thickness_start = 0.03999999910593033;
const float _baked_inner_size = 0.15000000596046448;
const float _baked_ray_threshold = 0.6499999761581421;
const float _baked_ray_reach = 0.1599999964237213;
const float _baked_ray_thickness = 0.02500000037252903;
const float _baked_chip_threshold = 0.9100000262260437;
const float _baked_chip_density = 18.0;
const float _baked_ring_opacity = 0.699999988079071;
const float _baked_ray_opacity = 0.800000011920929;
const float _baked_brightness = 1.2000000476837158;
float hash(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453);}
void fragment(){
 vec2 p=((floor(UV*pixels)+0.5)/pixels-0.5)*2.0;
 float r=length(p);
 float a=atan(p.y,p.x);
 float spoke=floor((a+3.14159)*_baked_spokes);
 float noise=hash(vec2(spoke,seed));
 float ring_radius=_baked_ring_start+progress*(_baked_ring_growth+noise*_baked_ring_noise);
 float ring=1.0-step(_baked_ring_thickness+_baked_ring_thickness_start*(1.0-progress),abs(r-ring_radius));
 float inner=1.0-step(_baked_inner_size*(1.0-progress),r);
 float rays=step(_baked_ray_threshold,noise)*step(r,ring_radius+_baked_ray_reach)*(1.0-step(_baked_ray_thickness,abs(sin(a*_baked_spokes+seed))));
 float chips=step(_baked_chip_threshold,hash(floor(p*_baked_chip_density)+seed))*step(ring_radius-0.12,r)*step(r,ring_radius+0.13);
 float alpha=(ring*_baked_ring_opacity+inner+rays*_baked_ray_opacity+chips)*(1.0-progress);
 vec3 color=tint.rgb*(_baked_brightness+chips)+vec3(inner*1.4+ring*0.25);
 COLOR=vec4(color*_baked_effect_energy,clamp(alpha,0.0,1.0)*tint.a)*(linear_colors ? _baked_effect_color : _baked_effect_color_srgb);
}
