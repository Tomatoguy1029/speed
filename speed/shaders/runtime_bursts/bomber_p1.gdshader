// Generated by tools/art/bake_burst_profiles.py; keep the editable base shader.
// 自爆する雑魚の爆発。表示値はこのshaderと使用元の保存キーで独立して調整する。
// ドット単位の爆発。煙・火球と輪・燃えかす・火の粉を順に描く。
// 粒は小さな四角へ分け、軌道と寿命を頂点で計算する。fragment で全粒を走査しない。
// 火球は fire_burst と同じく、焼いた値ノイズで縁を崩し、密度で4段の色に分け、一番外を半透明にする。
// 長さはドット単位、時間は秒。粒の並びは seed から決まり、age だけで各時刻の絵が決まる。
// tuning の値は戦闘エフェクトツールで装備・攻撃ごとに上書きする（ShaderTuning）。
shader_type canvas_item;
render_mode unshaded;
uniform bool linear_colors = true;

#include "res://shaders/burst_noise.gdshaderinc"
uniform float half_cells = 120.0;
uniform float radius = 38.0;
uniform float age = 0.0;
// 爆発の中心のドット座標と種（ノイズと粒の並びを爆発ごとに変える）
uniform vec2 origin = vec2(0.0);
uniform float seed = 0.0;
// 0: 火球・閃光・輪、1: 煙、2: 燃えかす、3: 火の粉。全パスで同じ調整値と種を使う。
const int _baked_pass_mode = 1;
varying vec2 burst_position;
varying flat vec4 particle_state;
varying flat vec4 particle_extra;
varying flat vec4 particle_color;
varying flat float max_reach;
// 表示用の全体色と明るさ。CanvasItemのmodulateとは独立して適用する。
const vec4 _baked_effect_color = vec4(1.0, 1.0, 1.0, 1.0);
const vec4 _baked_effect_color_srgb = vec4(1.0, 1.0, 1.0, 1.0);
const float _baked_effect_energy = 1.0;
const vec4 _baked_c0 = vec4(1.0, 1.0, 1.0, 1.0);
const vec4 _baked_c0_srgb = vec4(1.0, 1.0, 1.0, 1.0);
const vec4 _baked_c1 = vec4(1.0, 0.8878815174102783, 0.3918048143386841, 1.0);
const vec4 _baked_c1_srgb = vec4(1.0, 0.9490000009536743, 0.6589999794960022, 1.0);
const vec4 _baked_c2 = vec4(1.0, 0.4338795244693756, 0.029488254338502884, 1.0);
const vec4 _baked_c2_srgb = vec4(1.0, 0.6899999976158142, 0.18799999356269836, 1.0);
const vec4 _baked_c3 = vec4(0.6453084945678711, 0.06146494299173355, 0.011645428836345673, 1.0);
const vec4 _baked_c3_srgb = vec4(0.8240000009536743, 0.2750000059604645, 0.10999999940395355, 1.0);
const vec4 _baked_smoke_dark = vec4(0.04214945062994957, 0.02322782203555107, 0.0253068208694458, 1.0);
const vec4 _baked_smoke_dark_srgb = vec4(0.22699999809265137, 0.16500000655651093, 0.17299999296665192, 1.0);
const vec4 _baked_smoke_mid = vec4(0.1121688112616539, 0.06146494299173355, 0.05794929340481758, 1.0);
const vec4 _baked_smoke_mid_srgb = vec4(0.36899998784065247, 0.2750000059604645, 0.2669999897480011, 1.0);
const vec4 _baked_smoke_light = vec4(0.25397154688835144, 0.14435912668704987, 0.1121688112616539, 1.0);
const vec4 _baked_smoke_light_srgb = vec4(0.5410000085830688, 0.41600000858306885, 0.36899998784065247, 1.0);
const float _baked_noise_scale = 0.1599999964237213;
const float _baked_roughness = 0.949999988079071;
const float _baked_outer_alpha = 0.5;
const float _baked_grow_seconds = 0.20000000298023224;
const float _baked_start_size = 0.25;
const float _baked_fire_seconds = 0.75;
const float _baked_burn_speed = 0.8500000238418579;
const float _baked_cool_speed = 0.800000011920929;
const float _baked_hole_size = 0.6499999761581421;
const float _baked_flash_seconds = 0.03999999910593033;
const float _baked_flash_size = 0.5;
const float _baked_ring_seconds = 0.30000001192092896;
const float _baked_ring_size = 1.25;
const float _baked_ring_alpha = 0.949999988079071;
const float _baked_spark_count = 40.0;
const float _baked_spark_speed = 1.0;
const float _baked_spark_seconds = 0.5;
const float _baked_cinder_count = 60.0;
const float _baked_cinder_speed = 1.0;
const float _baked_cinder_seconds = 0.699999988079071;
const float _baked_smoke_count = 13.0;
const float _baked_smoke_alpha = 0.699999988079071;
const float _baked_smoke_seconds = 0.800000011920929;

// 共通の爆発計算。artist値のuniform宣言と所有は各専用shaderに置く。
// 粒 i の k 番目の乱数（0〜1）
float rnd(float i, float k) {
	return fract(sin(dot(vec3(i, k, seed), vec3(12.9898, 78.233, 37.719))) * 43758.5453);
}

// 下に重ねた色の上へ、色 c を不透明度 a で重ねる
vec4 over(vec4 dst, vec3 c, float a) {
	float out_a = a + dst.a * (1.0 - a);
	if (out_a <= 0.0) return vec4(0.0);
	return vec4((c * a + dst.rgb * dst.a * (1.0 - a)) / out_a, out_a);
}

float out_quart(float t) { return 1.0 - pow(1.0 - clamp(t, 0.0, 1.0), 4.0); }
float out_cubic(float t) { return 1.0 - pow(1.0 - clamp(t, 0.0, 1.0), 3.0); }

// 減速しながら飛ぶ粒の、t 秒までに進んだ距離（抵抗は毎秒 0.6）
float drift(float v0, float t) { return v0 * (1.0 - exp(-0.6 * t)) / 0.6; }

// 煙の中心・半径・不透明度。従来と同じ乱数と軌道を、粒の4頂点で求める。
vec4 smoke_state(float i) {
	if (i >= _baked_smoke_count || age <= 0.12) return vec4(0.0);
	float R = max(radius, 1.0);
	float t0 = mix(0.12, 0.3, rnd(i, 21.0));
	float span = mix(0.75, 1.0, rnd(i, 22.0)) * _baked_smoke_seconds;
	float u = (age - t0) / span;
	if (u <= 0.0 || u >= 1.0) return vec4(0.0);
	float a = rnd(i, 23.0) * TAU;
	vec2 dir = vec2(cos(a), sin(a));
	vec2 v = vec2(dir.x * mix(4.0, 12.0, rnd(i, 24.0)), dir.y * mix(4.0, 12.0, rnd(i, 25.0)) - mix(1.0, 4.0, rnd(i, 26.0))) / 38.0 * R;
	vec2 c = dir * mix(0.25, 0.8, rnd(i, 27.0)) * R + v * u * span;
	float r = mix(10.0, 15.0, rnd(i, 28.0)) / 38.0 * R * (0.7 + 0.6 * out_cubic(u));
	float k = _baked_smoke_alpha * pow(1.0 - u, 1.3) * smoothstep(0.0, 0.2, u);
	return vec4(c, r, k);
}

// 燃えかすの左上のセル・寿命比・大きさ。非表示の粒は寿命比を負にする。
vec4 cinder_state(float i) {
	if (i >= _baked_cinder_count || age <= 0.18 * _baked_fire_seconds / 0.75) return vec4(0.0, 0.0, -1.0, 0.0);
	float R = max(radius, 1.0);
	float t0 = mix(0.24, 0.67, rnd(i, 31.0)) * _baked_fire_seconds;
	float span = mix(0.43, 1.0, rnd(i, 32.0)) * _baked_cinder_seconds;
	float k = (age - t0) / span;
	if (k <= 0.0 || k >= 1.0) return vec4(0.0, 0.0, -1.0, 0.0);
	if (k > 0.6 && sin(age * 40.0 + rnd(i, 33.0) * 9.0) < 0.0) return vec4(0.0, 0.0, -1.0, 0.0);
	float a = rnd(i, 34.0) * TAU;
	float r0 = mix(0.55, 1.05, rnd(i, 35.0)) * R * (0.6 + 0.4 * smoothstep(0.15, 0.6, t0 / _baked_fire_seconds));
	float r = r0 + mix(6.0, 22.0, rnd(i, 36.0)) / 38.0 * R * _baked_cinder_speed * k * span;
	vec2 at = floor(vec2(cos(a), sin(a)) * r);
	return vec4(at, k, rnd(i, 37.0) < 0.5 && k < 0.6 ? 1.0 : 0.0);
}

// 火の粉の頭・向き、長さ・不透明度、色。
void spark_state(float i, out vec4 state, out vec4 extra, out vec4 color) {
	state = vec4(0.0);
	extra = vec4(0.0);
	color = vec4(0.0);
	if (i >= _baked_spark_count || age >= _baked_spark_seconds + 0.06) return;
	float t = age - rnd(i, 41.0) * 0.06;
	float span = mix(0.4, 1.0, rnd(i, 42.0)) * _baked_spark_seconds;
	if (t < 0.0 || t >= span) return;
	float R = max(radius, 1.0);
	float a = rnd(i, 43.0) * TAU;
	vec2 dir = vec2(cos(a), sin(a));
	float v0 = R * mix(2.4, 6.6, rnd(i, 44.0)) * _baked_spark_speed;
	vec2 head = dir * (R * 0.16 + drift(v0, t));
	float len = min(16.0, 0.5 + v0 * exp(-0.6 * t) * 0.026) * mix(0.7, 1.4, rnd(i, 45.0));
	float k = 1.0 - t / span;
	float pick = rnd(i, 46.0);
	state = vec4(head, dir);
	extra = vec4(len, k < 0.35 ? k / 0.35 : 1.0, 0.0, 0.0);
	color = pick < 0.25 ? (linear_colors ? _baked_c0 : _baked_c0_srgb) : pick < 0.75 ? (linear_colors ? _baked_c1 : _baked_c1_srgb) : (linear_colors ? _baked_c2 : _baked_c2_srgb);
}

void vertex() {
	float R = max(radius, 1.0);
	max_reach = half_cells;
	if (age < _baked_spark_seconds + 0.06) max_reach = max(max_reach, R * 0.16 + drift(R * 6.6 * _baked_spark_speed, age) + 17.0);
	if (age < _baked_ring_seconds) max_reach = max(max_reach, R * (0.21 + _baked_ring_size) + 3.0);
	particle_state = vec4(0.0);
	particle_extra = vec4(0.0);
	particle_color = vec4(0.0);
	if (_baked_pass_mode == 0) {
		// 火球の四角を火の粉の最大到達距離まで広げない。
		float core_reach = 0.0;
		if (age < _baked_fire_seconds) core_reach = R * (_baked_start_size + (1.0 - _baked_start_size) * out_quart(age / _baked_grow_seconds)) * 1.2 + 1.0;
		if (age < _baked_flash_seconds) core_reach = max(core_reach, R * 0.16 + R * _baked_flash_size * age / _baked_flash_seconds);
		if (age < _baked_ring_seconds) {
			float ru = age / _baked_ring_seconds;
			core_reach = max(core_reach, R * (0.21 + _baked_ring_size * out_cubic(ru)) + (ru < 0.4 ? 2.0 : 1.0));
		}
		float bound = min(half_cells, ceil(core_reach));
		burst_position = (UV - 0.5) * 2.0 * bound;
		VERTEX = burst_position / half_cells;
	} else {
		// UV.x は粒番号 * 2 + 四角内の x。全頂点で同じ粒番号を復元する。
		float i = floor(UV.x * 0.5);
		vec2 corner = vec2(UV.x - i * 2.0, UV.y);
		vec2 low = vec2(0.0);
		vec2 high = vec2(0.0);
		if (_baked_pass_mode == 1) {
			particle_state = smoke_state(i);
			if (particle_state.w > 0.0) {
				low = floor(particle_state.xy - particle_state.z - 1.0);
				high = ceil(particle_state.xy + particle_state.z + 1.0);
			}
		} else if (_baked_pass_mode == 2) {
			particle_state = cinder_state(i);
			if (particle_state.z > 0.0) {
				low = particle_state.xy;
				high = low + vec2(2.0);
			}
		} else {
			// varying は vertex 本体で代入する。
			vec4 state;
			vec4 extra;
			vec4 color;
			spark_state(i, state, extra, color);
			particle_state = state;
			particle_extra = extra;
			particle_color = color;
			if (extra.y > 0.0) {
				vec2 tail = state.xy - state.zw * extra.x;
				low = floor(min(state.xy, tail) - 2.0);
				high = ceil(max(state.xy, tail) + 2.0);
			}
		}
		// 元の四角の範囲とセルの格子を保つ。非表示の粒は面積ゼロ。
		low = clamp(low, vec2(-half_cells), vec2(half_cells));
		high = clamp(high, vec2(-half_cells), vec2(half_cells));
		burst_position = mix(low, high, corner);
		VERTEX = burst_position / half_cells;
	}
}

void fragment() {
	vec2 cell = floor(burst_position);
	vec2 p = cell + 0.5;
	float dist = length(p);
	if (dist > max_reach) discard;
	float R = max(radius, 1.0);
	vec4 col = vec4(0.0);
	if (_baked_pass_mode == 1) {
		vec2 c = particle_state.xy;
		float r = particle_state.z;
		float k = particle_state.w;
		if (length(p - c) <= r) col = over(col, (linear_colors ? _baked_smoke_dark : _baked_smoke_dark_srgb).rgb, k * (linear_colors ? _baked_smoke_dark : _baked_smoke_dark_srgb).a);
		if (length(p - c + vec2(0.2, 0.25) * r) <= r * 0.75) col = over(col, (linear_colors ? _baked_smoke_mid : _baked_smoke_mid_srgb).rgb, k * 0.55 * (linear_colors ? _baked_smoke_mid : _baked_smoke_mid_srgb).a);
		if (length(p - c + vec2(0.35, 0.4) * r) <= r * 0.4) col = over(col, (linear_colors ? _baked_smoke_light : _baked_smoke_light_srgb).rgb, k * 0.35 * (linear_colors ? _baked_smoke_light : _baked_smoke_light_srgb).a);
	} else if (_baked_pass_mode == 2) {
		vec2 at = particle_state.xy;
		float k = particle_state.z;
		bool big = particle_state.w > 0.5;
		vec4 c = k < 0.3 ? (linear_colors ? _baked_c0 : _baked_c0_srgb) : k < 0.65 ? (linear_colors ? _baked_c1 : _baked_c1_srgb) : (linear_colors ? _baked_c2 : _baked_c2_srgb);
		if (cell == at || (big && cell == at + vec2(1.0, 0.0))) col = c;
		else if (big && cell == at + vec2(0.0, 1.0)) col = (linear_colors ? _baked_c2 : _baked_c2_srgb);
	} else if (_baked_pass_mode == 3) {
		vec2 dir = particle_state.zw;
		vec2 rel = p - particle_state.xy;
		float along = dot(rel, dir);
		float len = particle_extra.x;
		if (along > 0.5 || along < -len || abs(rel.x * dir.y - rel.y * dir.x) > 0.55) discard;
		vec3 c = particle_color.rgb;
		if (along < -len * 0.4) c *= 0.55;
		col = vec4(c, particle_extra.y * particle_color.a);
	} else {
		// 火球：煙の上、燃えかすと火の粉の下。
		float life = age / _baked_fire_seconds;
		if (life < 1.0) {
			float rt = R * (_baked_start_size + (1.0 - _baked_start_size) * out_quart(age / _baked_grow_seconds));
			float d = length(cell) / max(rt, 0.1);
			if (d <= 1.2) {
				vec2 at = cell + origin;
				float n = vnoise(vec3(at.x * _baked_noise_scale + seed, at.y * _baked_noise_scale - life * 3.0, life * 5.0 + seed));
				float hole = _baked_hole_size * smoothstep(0.15, 0.6, life);
				float den = (1.0 - abs(d - hole) / (1.0 - hole * 0.6)) * 1.35 + (n - 0.5) * _baked_roughness - life * _baked_burn_speed - smoothstep(0.35, 1.0, life) * _baked_cool_speed;
				if (age < _baked_flash_seconds) den += 0.6;
				if (den > 0.8) col = over(col, (linear_colors ? _baked_c0 : _baked_c0_srgb).rgb, (linear_colors ? _baked_c0 : _baked_c0_srgb).a);
				else if (den > 0.55) col = over(col, (linear_colors ? _baked_c1 : _baked_c1_srgb).rgb, (linear_colors ? _baked_c1 : _baked_c1_srgb).a);
				else if (den > 0.33) col = over(col, (linear_colors ? _baked_c2 : _baked_c2_srgb).rgb, (linear_colors ? _baked_c2 : _baked_c2_srgb).a);
				else if (den > 0.16) col = over(col, (linear_colors ? _baked_c3 : _baked_c3_srgb).rgb, (linear_colors ? _baked_c3 : _baked_c3_srgb).a * _baked_outer_alpha);
			}
		}
		if (age < _baked_flash_seconds && dist <= R * 0.16 + R * _baked_flash_size * age / _baked_flash_seconds) col = over(col, (linear_colors ? _baked_c0 : _baked_c0_srgb).rgb, (linear_colors ? _baked_c0 : _baked_c0_srgb).a);
		float ru = age / _baked_ring_seconds;
		if (ru < 1.0) {
			float rr = R * (0.21 + _baked_ring_size * out_cubic(ru));
			float w = ru < 0.4 ? 2.0 : 1.0;
			if (abs(dist - rr) <= w && vnoise(vec3(p * 0.25 + seed, ru * 3.0 + 9.0)) >= 0.2 + ru * 0.5) {
				vec4 ring_color = ru < 0.3 ? (linear_colors ? _baked_c0 : _baked_c0_srgb) : (linear_colors ? _baked_c1 : _baked_c1_srgb);
				col = over(col, ring_color.rgb, ring_color.a * _baked_ring_alpha * (ru < 0.5 ? 1.0 : 0.58));
			}
		}
	}
	if (col.a <= 0.0) discard;
	COLOR = vec4(col.rgb * _baked_effect_energy, col.a) * (linear_colors ? _baked_effect_color : _baked_effect_color_srgb);
}
