shader_type canvas_item;
render_mode unshaded, blend_premul_alpha;
uniform sampler2D enemy0 : source_color, filter_nearest;
uniform sampler2D enemy1 : source_color, filter_nearest;
uniform sampler2D enemy2 : source_color, filter_nearest;
uniform sampler2D enemy3 : source_color, filter_nearest;
uniform sampler2D enemy4 : source_color, filter_nearest;
uniform sampler2D enemy5 : source_color, filter_nearest;
uniform sampler2D enemy6 : source_color, filter_nearest;
uniform float clock = 0.0;
uniform float contents_count = 7.0;
uniform float contents_fill = 1.0;
uniform float trail_reach = 1000000.0;
const vec4 bolt_dark = vec4(0.006991462782025337, 0.1878308653831482, 0.059516385197639465, 1.0);
const vec4 bolt_dark_srgb = vec4(0.07840000092983246, 0.4706000089645386, 0.27059999108314514, 1.0);
const vec4 bolt_edge = vec4(0.014445722103118896, 0.41784214973449707, 0.10221695154905319, 1.0);
const vec4 bolt_edge_srgb = vec4(0.12549999356269836, 0.6783999800682068, 0.3528999984264374, 1.0);
const vec4 bolt_mid = vec4(0.036901164799928665, 0.8468490242958069, 0.19459034502506256, 1.0);
const vec4 bolt_mid_srgb = vec4(0.2117999941110611, 0.9294000267982483, 0.47839999198913574, 1.0);
const vec4 bolt_pale = vec4(0.25417616963386536, 1.0, 0.4451455771923065, 1.0);
const vec4 bolt_pale_srgb = vec4(0.5411999821662903, 1.0, 0.6980000138282776, 1.0);
const vec4 bolt_light = vec4(0.6514924764633179, 1.0, 0.7834603786468506, 1.0);
const vec4 bolt_light_srgb = vec4(0.8274999856948853, 1.0, 0.8980000019073486, 1.0);
const vec4 bolt_core = vec4(1.0, 1.0, 1.0, 1.0);
const vec4 bolt_core_srgb = vec4(1.0, 1.0, 1.0, 1.0);
const float bolt_scale = 3.0;
const float bolt_length = 64.0;
const float bolt_width = 2.0;
const float bolt_period = 0.5;
const float bolt_brightness = 1.0;
const float pulse_speed = 3.0;
const float pulse_strength = 1.0;
const float spiral_opacity = 1.0;
const float tail_count = 14.0;
const float tail_opacity = 1.0;
const float glint_scale = 2.0;
const float glow_strength = 1.7000000476837158;
const float contents_opacity = 1.0;
const float contents_scale = 1.0;
uniform bool linear_colors = true;
varying vec2 bolt_pixel;
const vec2 POS[7] = vec2[7](vec2(0,-13),vec2(-14,-4),vec2(13,-3),vec2(-10,12),vec2(12,12),vec2(1,9),vec2(0,-1));
const float SIZES[7] = float[7](0.78,0.72,0.70,0.70,0.76,0.78,0.86);
const float ANGLES[7] = float[7](-0.314159,0.174533,-0.20944,0.523599,-0.349066,0.139626,0.0);

// 固定seed=2の元のbeat/Rng値。固定乱数は制作時に計算し、実行時は経過時刻だけを使う。
const float DASH_LIFE[14] = float[14](0.216977138,0.206188485,0.184512723,0.231024276,0.297894948,0.270184234,0.196779335,0.279523689,0.205163588,0.229678093,0.215649000,0.240862708,0.189775562,0.279919387);
const float DASH_SPEED[14] = float[14](166.710021403,225.850652978,214.750811439,220.731766932,215.703779552,210.474469531,182.992129084,188.235764969,229.655174501,183.260197788,223.109547067,170.215984099,190.943939667,162.188824639);
const float DASH_LENGTH[14] = float[14](6.450921136,6.457275423,4.406623228,5.117607022,3.703897836,3.926424518,6.520277004,4.672039022,6.433415536,5.537434155,6.649287096,5.040151072,5.893924965,4.058034878);
const float DASH_JITTER[14] = float[14](0.581434672,0.317614623,0.261262306,0.351650613,-0.338971980,-0.497362556,0.289197627,-0.163674400,-0.036491740,0.129276842,0.055147833,-0.088160116,-0.573155767,0.104019346);
const float DASH_SALT[14] = float[14](84.000000000,791.000000000,477.000000000,675.000000000,703.000000000,491.000000000,229.000000000,334.000000000,106.000000000,912.000000000,79.000000000,38.000000000,789.000000000,353.000000000);

void vertex() {
	// 光のx方向とpivotを保持し、敵塊の上下へ余白を持たせる。
	bolt_pixel = UV*vec2(132.0,48.0)-vec2(108.0,24.0);
	VERTEX = bolt_pixel*bolt_scale+vec2(55.0,0.0);
}
uint hash_step(uint h, uint n) {
	h = (h^n)*0x85ebca6bu;
	h ^= h>>13u;
	h *= 0xc2b2ae35u;
	return h^(h>>16u);
}
float random2(int a, int b) {
	return float(hash_step(hash_step(0x9e3779b9u,uint(a)),uint(b)))/4294967296.0;
}
vec4 ramp(int level) {
	if (level <= 2) return (linear_colors ? bolt_dark : bolt_dark_srgb);
	if (level == 3) return (linear_colors ? bolt_edge : bolt_edge_srgb);
	if (level == 4) return (linear_colors ? bolt_mid : bolt_mid_srgb);
	if (level == 5) return (linear_colors ? bolt_pale : bolt_pale_srgb);
	if (level == 6) return (linear_colors ? bolt_light : bolt_light_srgb);
	return (linear_colors ? bolt_core : bolt_core_srgb);
}
float glow_at(vec2 p, vec2 center, float radius) {
	float f = max(0.0,1.0-length(p-center)/max(radius,0.01));
	return f*f;
}
vec4 piece(int j, vec2 uv) {
	if (j == 0) return texture(enemy0,uv);
	if (j == 1) return texture(enemy1,uv);
	if (j == 2) return texture(enemy2,uv);
	if (j == 3) return texture(enemy3,uv);
	if (j == 4) return texture(enemy4,uv);
	if (j == 5) return texture(enemy5,uv);
	return texture(enemy6,uv);
}
vec2 piece_size(int j) {
	if (j == 0) return vec2(textureSize(enemy0,0));
	if (j == 1) return vec2(textureSize(enemy1,0));
	if (j == 2) return vec2(textureSize(enemy2,0));
	if (j == 3) return vec2(textureSize(enemy3,0));
	if (j == 4) return vec2(textureSize(enemy4,0));
	if (j == 5) return vec2(textureSize(enemy5,0));
	return vec2(textureSize(enemy6,0));
}
void fragment() {
	vec2 cell = floor(bolt_pixel);
	vec2 p = cell+0.5;
	float phase = clock/bolt_period;
	int frame = int(floor(clock*30.0+0.000001));
	vec4 col = vec4(0.0);
	vec3 light = vec3(0.0);
	// 元の等間隔beat。後ろへ揺れ、冷えながら離れる短いdash。
	for (int i=0; i<14; i++) {
		if (float(i) >= tail_count) break;
		float age = mod(clock-float(i)*bolt_period/max(tail_count,1.0)+0.0000001,bolt_period);
		float k = age/DASH_LIFE[i];
		if (k >= 1.0) continue;
		float x0 = -bolt_length*0.8-age*DASH_SPEED[i];
		float len = DASH_LENGTH[i]*(1.0-k*0.5);
		float y = 0.5+sin(x0*0.25+phase*TAU*2.0)*(0.5+k*1.5)+DASH_JITTER[i]*k;
		if (x0-len < -106.0 || random2(frame,int(DASH_SALT[i])) < k*0.5) continue;
		if (cell.x <= floor(x0) && cell.x >= floor(x0-len) && cell.y == floor(y)) {
			col = ramp(k < 0.3 ? 5 : k < 0.6 ? 4 : 3);
			col.a *= tail_opacity;
		}
		if (k < 0.4) light += (linear_colors ? bolt_mid : bolt_mid_srgb).rgb*glow_at(p,vec2(x0-len*0.5,y),4.0)*0.3*(1.0-k)*tail_opacity;
	}
	// 丸い頭、白い芯と段階色、後方へ細くなる帯、帯を走るパルス。
	float d = -p.x+3.0;
	float u = d/(bolt_length+3.0);
	if (u >= 0.0 && u <= 1.0 && p.y >= -5.0*bolt_width && p.y <= 6.0*bolt_width) {
		float head = d < 3.0 ? sqrt(max(0.0,1.0-pow((3.0-d)/3.0,2.0))) : 1.0;
		float width = (3.4*pow(1.0-u,0.9)+0.5)*head*(1.0+0.08*sin(d*0.9-phase*TAU*4.0))*bolt_width;
		float v = abs(p.y-0.5)/max(width,0.001);
		if (v <= 1.2 && !(v > 1.0 && (u > 0.5 || random2(int(floor(p.x)),frame) > 0.6))) {
			int level = v < 0.22 ? (u < 0.6 ? 7 : 6) : v < 0.45 ? 6-(u > 0.5 ? 1 : 0) : v < 0.72 ? 4 : v <= 1.0 ? 3 : 2;
			bool pulse = mod(d*0.05-phase*pulse_speed,1.0) < 0.12 && v < 0.72;
			col = mix(ramp(level),ramp(min(7,level+1)),pulse ? pulse_strength : 0.0);
		}
	}
	// 元の二重らせん。各pixelのxから粒の距離を直接求め、全粒走査を避ける。
	float sd = -cell.x;
	if (sd >= 2.0 && sd < bolt_length*0.7) {
		for (int side=0; side<2; side++) {
			float a = sd*0.45-phase*TAU*3.0+float(side)*PI;
			float sy = 0.5+sin(a)*(2.2*(1.0-sd/bolt_length)+0.6)*bolt_width;
			if (cos(a) > 0.3 && cell.y == floor(sy)) col = mix(col,cos(a) > 0.8 ? (linear_colors ? bolt_core : bolt_core_srgb) : (linear_colors ? bolt_light : bolt_light_srgb),spiral_opacity);
		}
	}
	float glint = 0.75+0.25*sin(phase*TAU*2.0);
	float arm = floor((3.0+floor(glint*2.0+0.5))*glint_scale+0.5);
	vec2 delta = cell-vec2(1.0,0.0);
	float distance = max(abs(delta.x),abs(delta.y));
	if (arm >= 1.0) {
		if ((delta.x == 0.0 || delta.y == 0.0) && distance > 0.0 && distance <= arm) col = distance > arm*0.6 ? (linear_colors ? bolt_mid : bolt_mid_srgb) : (linear_colors ? bolt_light : bolt_light_srgb);
		if (arm >= 3.0 && abs(delta.x) == 1.0 && abs(delta.y) == 1.0) col = (linear_colors ? bolt_light : bolt_light_srgb);
		if (arm >= 6.0 && abs(delta.x) == 2.0 && abs(delta.y) == 2.0) col = (linear_colors ? bolt_mid : bolt_mid_srgb);
		if (distance == 0.0) col = (linear_colors ? bolt_core : bolt_core_srgb);
		light += (linear_colors ? bolt_light : bolt_light_srgb).rgb*glow_at(p,vec2(1.0,0.5),4.0+arm*2.0)*0.5;
	}
	vec2 closest = vec2(clamp(p.x,-bolt_length,1.0),0.5);
	light += (linear_colors ? bolt_edge : bolt_edge_srgb).rgb*glow_at(p,closest,9.0)*0.4;
	light += (linear_colors ? bolt_edge : bolt_edge_srgb).rgb*glow_at(p,vec2(-2.0,0.5),20.0)*0.5*glint;
	light += (linear_colors ? bolt_core : bolt_core_srgb).rgb*glow_at(p,vec2(1.0,0.5),6.0)*0.25;
	COLOR = vec4((col.rgb*col.a+light*glow_strength)*bolt_brightness,col.a);
	// 収納した敵の塗装済み画像を光より前へ重ねる。発光で塊を白く塗り潰さない。
	float mass_scale = contents_scale*mix(0.55,1.0,clamp(contents_fill,0.0,1.0));
	if (contents_opacity > 0.001 && contents_count > 0.0 && abs(p.x) < 24.0 && abs(p.y) < 24.0) {
		vec4 mass = vec4(0.0);
		for (int j=0; j<7; j++) {
			if (float(j) >= contents_count) break;
			float a = ANGLES[j];
			vec2 size = piece_size(j);
			size /= max(1.0,max(size.x,size.y)/33.0);
			vec2 uv = mat2(vec2(cos(a),-sin(a)),vec2(sin(a),cos(a)))*(p*2.0/mass_scale-POS[j])/(size*SIZES[j])+0.5;
			if (all(greaterThanEqual(uv,vec2(0))) && all(lessThan(uv,vec2(1)))) {
				vec4 art = piece(j,uv);
				mass = vec4(mass.rgb*(1.0-art.a)+art.rgb*art.a,art.a+mass.a*(1.0-art.a));
			}
		}
		float alpha = mass.a*contents_opacity;
		COLOR = vec4(COLOR.rgb*(1.0-alpha)+mass.rgb*contents_opacity,alpha+COLOR.a*(1.0-alpha));
	}
	// 射出直後の長い尾は口より後ろへ描かない。判定・弾の位置はそのまま。
	if (p.x*bolt_scale < -trail_reach) COLOR = vec4(0.0);
}
