[gd_resource type="BehaviorTree" format=3]

[ext_resource type="Script" path="res://scripts/bosses/tasks/attack_ready.gd" id="1_ready"]
[ext_resource type="Script" path="res://scripts/bosses/tasks/play_attack.gd" id="2_play"]

[sub_resource type="BTCondition" id="BTCondition_tech"]
script = ExtResource("1_ready")
attack = &"technique"

[sub_resource type="BTAction" id="BTAction_tech"]
script = ExtResource("2_play")
attack = &"technique"

[sub_resource type="BTSequence" id="BTSequence_tech"]
children = [SubResource("BTCondition_tech"), SubResource("BTAction_tech")]

[resource]
description = "うみへび座：強めの技を出せるなら、羅針盤で予告して、使える技のタイムラインを再生する"
root_task = SubResource("BTSequence_tech")
