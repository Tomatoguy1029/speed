[gd_resource type="BehaviorTree" format=3]
[ext_resource type="Script" path="res://scripts/bosses/tasks/hydra_normal_ready.gd" id="ready"]
[ext_resource type="Script" path="res://scripts/bosses/tasks/hydra_normal_play.gd" id="play"]
[ext_resource type="Script" path="res://scripts/bosses/tasks/hydra_position.gd" id="position"]
[ext_resource type="Script" path="res://scripts/bosses/tasks/hydra_weighted_selector.gd" id="weighted"]
[sub_resource type="BTCondition" id="ready_bite_thrust"]
script = ExtResource("ready")
attack = &"bite_thrust"
[sub_resource type="BTAction" id="play_bite_thrust"]
script = ExtResource("play")
attack = &"bite_thrust"
[sub_resource type="BTSequence" id="bite_thrust"]
children = [SubResource("ready_bite_thrust"),SubResource("play_bite_thrust")]
metadata/_weight_ = 1.0
