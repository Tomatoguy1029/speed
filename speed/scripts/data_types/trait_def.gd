## 画面に出る名前と説明。編集元は docs/game/text.md。翻訳キーは strings.csv の trait.<ID>.name／.desc。
func get_display_name() -> String:
	return tr("trait.%s.name" % id)

func get_description() -> String:
	return tr("trait.%s.desc" % id)
