; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Speed"
run/main_scene="res://scenes/app/main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

ContentManager="*res://scripts/managers/content_manager.gd"
SaveManager="*res://scripts/managers/save_manager.gd"
ProfileManager="*res://scripts/managers/profile_manager.gd"
AudioManager="*res://scripts/managers/audio_manager.gd"
GameManager="*res://scripts/managers/game_manager.gd"
RunManager="*res://scripts/managers/run_manager.gd"
DevBootstrap="*res://scripts/dev/bootstrap.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

export/convert_text_resources_to_binary=false

[editor_plugins]

enabled=PackedStringArray("res://addons/boss_flow/plugin.cfg", "res://addons/content_build/plugin.cfg", "res://addons/spawn_timeline/plugin.cfg", "res://addons/speed_data_editor/plugin.cfg", "res://addons/stage_enemy_tuning/plugin.cfg", "res://addons/stage_launcher/plugin.cfg")

[gui]

theme/custom="res://assets/ui/theme.tres"

[internationalization]

locale/translations=PackedStringArray("res://data/text/strings.ja.translation", "res://data/text/strings.en.translation")

[physics]

common/physics_ticks_per_second=120
3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
textures/vram_compression/import_etc2_astc=true

[spawn_timeline]

enemy_dir="res://data/enemies"
defaults_resource="res://data/config.tres"
default_stage="res://data/stages/stage_1.tres"

[speed_data_editor]

data_dir="res://data"

[stage_launcher]

stage_dir="res://scenes/stages/"
